# Shared configuration for the k8s one-shot build/test runners.
# Sourced by every script in k8s/scripts/. Any value can be overridden per
# invocation, e.g.:  NAMESPACE=builds IMAGE=foo:bar ./build.sh

# --- cluster ---------------------------------------------------------------
# kubeconfig context of the colima VM (docker+k3s runtime)
KUBE_CONTEXT="${KUBE_CONTEXT:-colima}"
NAMESPACE="${NAMESPACE:-offbook-build}"
COLIMA_PROFILE="${COLIMA_PROFILE:-default}"

# Alternative kubectl binary (mirrors the old NAS workflow's KUBECTL var)
KUBECTL="${KUBECTL:-kubectl}"

# --- toolchain image -------------------------------------------------------
# Built by image.sh with the colima docker daemon, imported into k3s containerd.
IMAGE="${IMAGE:-localhost/offbook-android-builder:jdk21}"

# --- build job -------------------------------------------------------------
GRADLE_TASK="${GRADLE_TASK:-assembleDebug}"
JOB_CPU_LIMIT="${JOB_CPU_LIMIT:-3}"        # colima default VM: 6 CPU / 6 GiB
JOB_MEM_LIMIT="${JOB_MEM_LIMIT:-5000Mi}"
# Single-JVM profile (in-process Kotlin compilation): one predictable heap
# covers every phase incl. R8 release minification. The VM has no swap, so
# keep actual usage well under JOB_MEM_LIMIT and leave room for co-tenants.
GRADLE_OPTS_VALUE="${GRADLE_OPTS_VALUE:--Dorg.gradle.jvmargs=-Xmx3072m -Dkotlin.compiler.execution.strategy=in-process -Dorg.gradle.workers.max=2}"
JOB_DEADLINE_SECONDS="${JOB_DEADLINE_SECONDS:-2400}"

# --- watch deploy (deploy.sh) ---------------------------------------------
# Enable Developer options > ADB debugging > "Debug over Wi-Fi" on the watch.
WATCH_IP="${WATCH_IP:-}"
# Empty/auto = discover the rotating port each session (survives watch
# reboots). Set a fixed value (e.g. 5555) only right after `adb tcpip 5555`.
WATCH_PORT="${WATCH_PORT:-}"
# Seconds a deploy Job keeps retrying adb connect before giving up, so the
# watch can join the network (or be picked up) after the job starts.
WATCH_WAIT_SECONDS="${WATCH_WAIT_SECONDS:-30}"
APP_ID="${APP_ID:-com.devlight.offbookplus}"
MAIN_ACTIVITY="${MAIN_ACTIVITY:-com.devlight.offbookplus.presentation.MainActivity}"
